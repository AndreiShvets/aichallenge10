# Ключ авторизации GigaChat API (Base64(Client ID:Client Secret)) — обязателен.
GIGACHAT_CREDENTIALS=

# Необязательно: GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B, GIGACHAT_API_CORP
# GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Персональный API-ключ шлюза Veai из личного кабинета https://app.veai.ru
# (блок «Подключение к Veai») — обязателен.
VEAI_CREDENTIALS=
