# Скопируйте этот файл в .env на уровень выше корня репозитория
# (например D:\projects\ai\.env) или в папку задачи, и вставьте ключ
# авторизации из личного кабинета GigaChat API (он же Base64(Client ID:Client Secret)).
GIGACHAT_CREDENTIALS=

# Необязательно: GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B, GIGACHAT_API_CORP
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
